# Backend Environment Variables
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Local PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codeforge
DB_USERNAME=codeforge_user
DB_PASSWORD=codeforge_local_password

# Supabase Production Database Example:
# DB_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your-secure-supabase-password

# Session & Security
SESSION_SECRET=a_very_secure_random_string_at_least_32_characters_long
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth (Optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Judge0 API
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
