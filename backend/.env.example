# Backend Environment Variables
SPRING_PROFILES_ACTIVE=supabase
PORT=8080

# Supabase PostgreSQL Configuration:
# Retrieve from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI / JDBC)
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# Security & Sessions
SESSION_SECRET=a_very_secure_random_string_at_least_32_characters_long
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth (Optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Judge0 API
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
