# ==========================================
# CodeForge Environment Variables Template
# ==========================================

# Active profile: local | supabase | prod
SPRING_PROFILES_ACTIVE=supabase

# Server Port
PORT=8080

# ==========================================
# Option A: Supabase-Hosted PostgreSQL
# ==========================================
# Found in your Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC:
# Format: jdbc:postgresql://<host>:5432/postgres?sslmode=require
# Or via Supabase Session Pooler (port 6543):
# Format: jdbc:postgresql://<host>:6543/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# ==========================================
# Option B: Local Docker PostgreSQL
# ==========================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=codeforge
# DB_USERNAME=codeforge_user
# DB_PASSWORD=codeforge_local_password

# ==========================================
# Security & Sessions
# ==========================================
SESSION_SECRET=change-this-to-a-very-secure-random-32-byte-secret-in-production
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# Google OAuth2 Credentials (Optional in dev)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Judge0 Code Execution API
# ==========================================
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
